{
  "name": "deepseek-harness-desktop",
  "productName": "DeepSeek Harness Desktop",
  "version": "0.1.4",
  "description": "Desktop shell for the DeepSeek Harness (dsh) agent runtime.",
  "license": "MIT",
  "type": "module",
  "main": "src/main.js",
  "homepage": "https://github.com/sleep2agi/DeepSeek-Harness-Desktop",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sleep2agi/DeepSeek-Harness-Desktop.git"
  },
  "bugs": {
    "url": "https://github.com/sleep2agi/DeepSeek-Harness-Desktop/issues"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test \"src/**/*.test.js\"",
    "test:e2e": "node --test \"tests/**/*.test.js\"",
    "test:all": "npm run test && npm run test:e2e",
    "typecheck": "tsc --noEmit",
    "kernel:install": "node tools/install-kernel.js && node tools/install-node.js && node tools/prune-kernel.js",
    "scan:leaks": "node tools/scan-leaks.js",
    "scan:workflows": "node tools/scan-workflows.js",
    "prepack:app": "npm run test && npm run scan:leaks && npm run scan:workflows && npm run kernel:install",
    "pack": "npm run prepack:app && electron-builder --dir",
    "dist": "npm run prepack:app && electron-builder --publish never",
    "dist:win": "npm run prepack:app && electron-builder --win --publish never",
    "dist:mac": "npm run prepack:app && electron-builder --mac --publish never"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "org.sleep2agi.deepseek-harness-desktop",
    "productName": "DeepSeek Harness Desktop",
    "artifactName": "DeepSeek-Harness-Desktop-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*.js",
      "!src/**/*.test.js",
      "assets/icon.png",
      "package.json",
      "LICENSE",
      "NOTICE"
    ],
    "asar": true,
    "afterPack": "tools/after-pack.js",
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "zip", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Development"
    },
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "assets/entitlements.mac.plist",
      "extraResources": [
        "assets/icon.png"
      ],
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "notarize": true,
      "target": ["dmg", "zip"]
    },
    "dmg": {
      "title": "${productName} ${version}"
    }
  }
}
